class Room:
    def __init__(self, name):
        self.name = name

    def describe(self):
        print(f"This is the {self.name}.")

class House:
    def __init__(self, address):
        self.address = address
        # House creates and owns its Room objects (Composition)
        self.living_room = Room("Living Room")
        self.kitchen = Room("Kitchen")

    def show_house(self):
        print(f"House at {self.address}:")
        self.living_room.describe()
        self.kitchen.describe()

if __name__ == "__main__":
    my_house = House("123 Maple Street")
    my_house.show_house()
