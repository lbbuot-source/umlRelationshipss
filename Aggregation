class Song:
    def __init__(self, title):
        self.title = title

class Playlist:
    def __init__(self, name, songs):
        self.name = name
        self.songs = songs  # Playlist holds external Song objects (Aggregation)

    def show_playlist(self):
        print(f"Playlist '{self.name}':")
        for song in self.songs:
            print(f"- {song.title}")

